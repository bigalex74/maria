#!/usr/bin/env bash
set -uo pipefail

# Gemini CLI helper for Masha/OpenClaw.
# Default: try Gemini 3.1 Pro first, then fall back to Gemini 3 Flash when Pro
# is unavailable, over capacity, or times out.
# Usage:
#   scripts/gemini-smart "prompt"
#   scripts/gemini-smart -p "prompt"
#   scripts/gemini-smart --timeout 180 -p "prompt"

PRO_MODEL="${GEMINI_SMART_PRO_MODEL:-gemini-3.1-pro-preview}"
FLASH_MODEL="${GEMINI_SMART_FLASH_MODEL:-gemini-3-flash-preview}"
TIMEOUT_SECONDS="${GEMINI_SMART_TIMEOUT:-120}"

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --timeout)
      TIMEOUT_SECONDS="${2:-}"
      shift 2
      ;;
    --pro-model)
      PRO_MODEL="${2:-}"
      shift 2
      ;;
    --flash-model)
      FLASH_MODEL="${2:-}"
      shift 2
      ;;
    -h|--help)
      sed -n '2,16p' "$0"
      exit 0
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ ${#args[@]} -eq 0 ]]; then
  echo "Usage: $0 [-p] <prompt>" >&2
  exit 2
fi

# Normalize to headless mode. If user passed -p/--prompt, keep it. Otherwise use -p with all args as one prompt.
cmd_args=()
has_prompt_flag=0
for a in "${args[@]}"; do
  if [[ "$a" == "-p" || "$a" == "--prompt" ]]; then
    has_prompt_flag=1
  fi
  cmd_args+=("$a")
done
if [[ "$has_prompt_flag" -eq 0 ]]; then
  prompt="${args[*]}"
  cmd_args=(-p "$prompt")
fi

tmp_err="$(mktemp -t gemini-smart.XXXXXX.err)"
trap 'rm -f "$tmp_err"' EXIT

if timeout "$TIMEOUT_SECONDS" gemini --model "$PRO_MODEL" "${cmd_args[@]}" 2> >(tee "$tmp_err" >&2); then
  exit 0
fi

status=$?
err="$(cat "$tmp_err" 2>/dev/null || true)"
if grep -qiE 'MODEL_CAPACITY_EXHAUSTED|No capacity available|RESOURCE_EXHAUSTED|rateLimitExceeded|429|timed out|ModelNotFoundError' <<<"$err" || [[ "$status" -eq 124 ]]; then
  echo "[gemini-smart] Pro unavailable; retrying with $FLASH_MODEL" >&2
  exec timeout "$TIMEOUT_SECONDS" gemini --model "$FLASH_MODEL" "${cmd_args[@]}"
fi

exit "$status"
